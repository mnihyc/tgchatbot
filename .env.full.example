# Advanced reference. A normal deployment only needs .env.example's settings.
# Compose owns deployment data/temp paths; these defaults also work in a checkout.
APP_DATA_DIR=./data
# APP_TEMP_DIR=./tmp/bot
LOG_LEVEL=INFO
APP_HEALTH_INTERVAL_S=5
APP_HEALTH_MAX_AGE_S=30

# update.sh creates the local PostgreSQL password once in the existing .env.
# For development or an existing external PostgreSQL/pgvector service only:
# DATABASE_URL=postgresql://tgchatbot:your-password@localhost:5432/tgchatbot

TGBOT_TOKEN=
TGBOT_WHITELIST=
TGBOT_CONTROL_UID_WHITELIST=
TGBOT_KEYWORDS=bot,reply
TGBOT_IGNORE_KEYWORDS=
TGBOT_REPLY_TO_USER_MESSAGE=false
TGBOT_MIN_EDIT_INTERVAL_S=1.25
TGBOT_MAX_PHOTO_BYTES=3145728
TGBOT_MAX_DOCUMENT_BYTES=12582912
TGBOT_MAX_STICKER_BYTES=3145728
TGBOT_MAX_STICKER_FRAMES=4
TGBOT_MAX_VISUAL_FILE_FRAMES=10
TGBOT_MAX_VIDEO_KEYFRAME_CANDIDATES=300
TGBOT_LINK_PREFETCH_TIMEOUT_S=4.0
TGBOT_LINK_PREFETCH_MAX_URLS=2
TGBOT_LINK_PREFETCH_MAX_CHARS=1200
# Maximum fetched preview body and followed redirects.
TGBOT_LINK_PREFETCH_MAX_BYTES=262144
TGBOT_LINK_PREFETCH_MAX_REDIRECTS=5

# Empty selects the configured provider automatically; set explicitly for mixed setups.
DEFAULT_PROVIDER=
DEFAULT_CHAT_MODE=chat
DEFAULT_PROCESS_VISIBILITY=status
DEFAULT_RESPONSE_DELIVERY=edit
DEFAULT_STICKER_MODE=off
DEFAULT_PROMPT_INJECTION_MODE=augment
DEFAULT_TOOL_HISTORY_MODE=translated
DEFAULT_LINK_PREFETCH_MODE=off
DEFAULT_CHAT_MAX_ROUNDS=1
DEFAULT_ASSIST_MAX_ROUNDS=4
DEFAULT_AGENT_MAX_ROUNDS=6
DEFAULT_GROUP_SPONTANEOUS_REPLY_CHANCE=0
# Legacy alias still accepted: DEFAULT_GROUP_SPONTANEOUS_REPLY_IDLE_S
DEFAULT_GROUP_SPONTANEOUS_REPLY_DELAY_S=1200
DEFAULT_PRIVATE_REPLY_DELAY_S=0
DEFAULT_GROUP_REPLY_DELAY_S=5
DEFAULT_PROVIDER_RETRY_COUNT=1
# Optional display-name/time notes; stable sender/reply/forward attribution is always included.
DEFAULT_METADATA_INJECTION_MODE=on
# Display timezone for all chats, memory and logs. Stored timestamps stay UTC.
DEFAULT_METADATA_TIMEZONE=Asia/Singapore
DEFAULT_SYSTEM_PROMPT=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-nano
OPENAI_ENABLE_NATIVE_WEB_SEARCH=false
# 0 disables the explicit built-in web search cap.
OPENAI_NATIVE_WEB_SEARCH_MAX=1
OPENAI_REASONING_EFFORT=none
# off|on|auto|detailed|concise; "on" normalizes to "auto" for OpenAI.
OPENAI_REASONING_SUMMARY=off
OPENAI_TEXT_VERBOSITY=low
OPENAI_MAX_OUTPUT_TOKENS=4096
# 0 disables the image-count cap.
OPENAI_MAX_INPUT_IMAGES=0
# 0 disables the separate image compaction target.
OPENAI_COMPACT_TARGET_IMAGES=0
OPENAI_REQUEST_TIMEOUT_S=60.0
OPENAI_CONNECT_TIMEOUT_S=15.0

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=1.0
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40
# true requests thought text in responses via thinkingConfig.includeThoughts.
GEMINI_INCLUDE_THOUGHTS=false
# Thinking-token allowance: -1 is automatic; 0 requests disabled thinking. The selected model API validates supported values.
GEMINI_THINKING_BUDGET=
# Gemini 3 native thinkingLevel: minimal|low|medium|high. Do not set together with GEMINI_THINKING_BUDGET for Gemini 3 requests.
GEMINI_THINKING_LEVEL=
GEMINI_ENABLE_NATIVE_WEB_SEARCH=false
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_MAX_INPUT_IMAGES=3600
GEMINI_COMPACT_TARGET_IMAGES=3000
GEMINI_REQUEST_TIMEOUT_S=60.0
GEMINI_CONNECT_TIMEOUT_S=15.0

# Optional Chat Completions endpoints. Any one provider is sufficient.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MULTIMODAL_INPUT=true
DEEPSEEK_FUNCTION_TOOLS=true
DEEPSEEK_STRUCTURED_OUTPUT=json_object
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_REQUEST_TIMEOUT_S=60
# Optional provider-specific fields, e.g. {"thinking":{"type":"disabled"}}
DEEPSEEK_EXTRA_BODY=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Required when OPENROUTER_API_KEY is set; choose an exact model ID.
OPENROUTER_MODEL=
# Set true only for a model supporting image input.
OPENROUTER_MULTIMODAL_INPUT=false
OPENROUTER_FUNCTION_TOOLS=true
# json_schema for compatible models; json_object or prompt for others.
OPENROUTER_STRUCTURED_OUTPUT=json_object
OPENROUTER_MAX_OUTPUT_TOKENS=4096
OPENROUTER_REQUEST_TIMEOUT_S=60
OPENROUTER_EXTRA_BODY=

# Inline JSON array of additional named Chat Completions profiles.
# Example: [{"name":"fast","api_key_env":"ROUTER_KEY","base_url":"https://openrouter.ai/api/v1","model":"vendor/model","multimodal_input":true}]
LLM_PROVIDERS_JSON=

# Sticker preprocessing: same credentials/provider registry, separate from chat.
STICKER_BUILD_PROVIDER=gemini
STICKER_BUILD_MODEL=gemini-3.8-flash
# Flex is discounted synchronous processing; blank selects the provider default.
STICKER_BUILD_SERVICE_TIER=flex
STICKER_BUILD_REQUEST_TIMEOUT_S=600
STICKER_BUILD_MAX_OUTPUT_TOKENS=8192
STICKER_BUILD_CONCURRENCY=1
STICKER_BUILD_IMAGE_EMBEDDINGS=true
STICKER_MEDIA_MAX_FRAMES=3
STICKER_MEDIA_MAX_DIMENSION=512
STICKER_MEDIA_JPEG_QUALITY=85
STICKER_MEDIA_BACKGROUND=#ffffff
# Independent of memory's schema; other STICKER_EMBEDDING_* values inherit EMBEDDING_*.
STICKER_EMBEDDING_DIMENSIONS=3072
# STICKER_EMBEDDING_PROVIDER=gemini
# STICKER_EMBEDDING_MODEL=gemini-embedding-2
# Optional overrides use existing credentials; no second key is required.
STICKER_CANDIDATE_COUNT=5
STICKER_MAX_CANDIDATES=8
STICKER_RETRIEVAL_DEPTH=64
STICKER_RECENT_DELIVERIES=20
STICKER_CACHED_SESSIONS=32
STICKER_NEAR_DUPLICATE_SIMILARITY=0.985

# Conversation memory embeddings; also defaults for sticker route overrides.
# Defaults reuse GEMINI_API_KEY/GEMINI_BASE_URL. No embedding container is required.
# Without an embedding key, ordinary chat and lexical memory search remain usable.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
# The conversation schema requires 1536 dimensions.
EMBEDDING_DIMENSIONS=1536
# OpenAI-only example: change provider to openai and model to text-embedding-3-large;
# OPENAI_API_KEY/OPENAI_BASE_URL are then reused. Compatible endpoints use the same route.
# Unset optional overrides; do not leave these enabled with empty values.
# EMBEDDING_BASE_URL=https://example.com/v1
# EMBEDDING_API_KEY_ENV=MY_EMBEDDING_KEY
# EMBEDDING_API_KEY=your-embedding-key
# EMBEDDING_MODEL_REVISION=your-model-revision

# Optional transport/cache limits, inherited by each embedding client.
EMBEDDING_TIMEOUT_S=15
EMBEDDING_MAX_RETRIES=2
EMBEDDING_MAX_CONCURRENCY=4
EMBEDDING_REQUESTS_PER_MINUTE=120
EMBEDDING_CACHE_ENTRIES=512
# Bounded native Gemini Batch submissions; other embedding routes use ordinary requests.
EMBEDDING_BATCH_MAX_ITEMS=1000
EMBEDDING_BATCH_MAX_BYTES=8388608

# Optional model for learning source-backed facts/profiles; empty follows the chat model.
MEMORY_PROVIDER=
MEMORY_MODEL=

# Remote tools and file transfers.
SSH_EXEC_ENABLED=false
SSH_EXEC_HOST=
SSH_EXEC_PORT=22
SSH_EXEC_WORKDIR=/tmp/tgchatbot
SSH_EXEC_IDENTITY_FILE=
SSH_EXEC_CONNECT_TIMEOUT_S=10
SSH_EXEC_DEFAULT_TIMEOUT_S=20
SSH_EXEC_MAX_TOOL_TIMEOUT_S=120
SSH_EXEC_MAX_STDOUT_CHARS=16000
SSH_EXEC_MAX_STDERR_CHARS=8000
SSH_EXEC_MAX_INPUT_FILE_BYTES=8388608
SSH_EXEC_MAX_OUTPUT_FILES=5
SSH_EXEC_MAX_OUTPUT_FILE_BYTES=8388608
SSH_EXEC_SERVER_ALIVE_INTERVAL_S=30
SSH_EXEC_SERVER_ALIVE_COUNT_MAX=3
SSH_EXEC_CONTROL_PERSIST_S=600

# Remote read_doc rendering. PDF scale 2 = 144 dpi. The pixel bound limits
# per-image rendering work; 0 disables it. Originals remain unchanged.
READ_DOC_PDF_SCALE=2
READ_DOC_MAX_IMAGE_PIXELS=16777216

CONTEXT_COMPACT_TRIGGER_TOKENS=300000
CONTEXT_COMPACT_TARGET_TOKENS=100000
CONTEXT_COMPACT_BATCH_TOKENS=40000
CONTEXT_COMPACT_KEEP_RECENT_RAW_TOKEN_RATIO=0.5
CONTEXT_COMPACT_TOOL_RATIO_THRESHOLD=10.0
CONTEXT_COMPACT_TOOL_MIN_TOKENS=10000
CONTEXT_COMPACT_MIN_MESSAGES=24
CONTEXT_MIN_RAW_MESSAGES_RESERVE=8
# CONTEXT_COMPACTION_ATTEMPTS=24
# CONTEXT_ATTRIBUTION_RETRIES=1
# CONTEXT_SUMMARY_MIN_TOKENS=256
# CONTEXT_SUMMARY_FLOOR_TOKENS=1024
# CONTEXT_SUMMARY_MAX_TOKENS=16000

# Optional operational overrides (all belong in this same .env).
# Defaults are shown commented; you do not need to add these to an existing .env.
# Configure only the overrides needed by this installation.

# Reply context and memory tools.
# MEMORY_CACHED_SESSIONS=32
# Read cache only; compressed images remain in PostgreSQL after context compaction.
# MEMORY_PREVIEW_CACHE_BYTES=268435456
# MEMORY_QUERY_CHARS=2048
# MEMORY_QUERY_TIMEOUT_S=5.0
# MEMORY_SEARCH_RESULTS=20
# MEMORY_SEARCH_RESULT_CHARS=4000
# MEMORY_RESPONSE_CHARS=24000
# MEMORY_READ_MESSAGES=20
# MEMORY_READ_CHARS=12000
# Soft profile size target for generation; accepted facts are never cut to fit.
# MEMORY_PROFILE_BYTES=4096

# Background processing and source-backed profile generation.
# MEMORY_WORKER_EXCERPT_TOKENS=512
# MEMORY_WORKER_EXCERPT_CANDIDATE_CHARS=2048
# MEMORY_WORKER_CLAIM_JOBS=16
# MEMORY_WORKER_INGEST_SOURCES=100
# MEMORY_WORKER_EMBED_SOURCES=1000
# MEMORY_WORKER_MAX_ACTIVE_BATCHES=4
# MEMORY_WORKER_LEASE_SECONDS=900.0
# MEMORY_WORKER_HEARTBEAT_SECONDS=60.0
# MEMORY_WORKER_IDLE_SECONDS=5.0
# MEMORY_WORKER_ERROR_RETRY_SECONDS=5.0
# MEMORY_WORKER_CLEANUP_EVERY=20
# MEMORY_WORKER_BATCH_POLL_SECONDS=60.0
# MEMORY_WORKER_BATCH_RECONCILE_SECONDS=300.0
# MEMORY_WORKER_RETIRED_BATCH_TIMEOUT_S=60.0
# MEMORY_WORKER_TAIL_IDLE_SECONDS=1800.0
# Accumulated original-text threshold and batch size; a fetch can learn one partial batch.
# MEMORY_WORKER_PROFILE_REQUEST_BYTES=12000
# MEMORY_WORKER_PROFILE_OUTPUT_TOKENS=4096

# Database access and job lifecycle.
# MEMORY_DB_POOL_MIN_SIZE=
# MEMORY_DB_POOL_MAX_SIZE=
# MEMORY_DB_POOL_TIMEOUT_S=
# MEMORY_DB_STATEMENT_TIMEOUT_S=
# MEMORY_DB_LOCK_TIMEOUT_S=
# MEMORY_DB_INITIALIZATION_TIMEOUT_S=
# MEMORY_DB_READ_PAGE_SIZE=100
# MEMORY_DB_RECENT_PAGE_SIZE=20
# MEMORY_DB_HISTORY_PAGE_SIZE=1000
# MEMORY_DB_REVISION_PAGE_SIZE=20
# MEMORY_DB_MEMORY_BLOCK_PAGE_SIZE=128
# MEMORY_DB_SEARCH_RESULTS=20
# MEMORY_DB_PROFILE_RESULTS=50
# MEMORY_DB_JOB_CLAIM_SIZE=1
# MEMORY_DB_JOB_LEASE_SECONDS=60.0
# MEMORY_DB_JOB_MAX_ATTEMPTS=3
# MEMORY_DB_JOB_RETRY_DELAY_SECONDS=5.0
# MEMORY_DB_JOB_CLEANUP_PAGE_SIZE=1000
# MEMORY_DB_JOB_RETENTION_SECONDS=86400.0
# MEMORY_DB_RETIREMENT_PAGE_SIZE=1000
# MEMORY_DB_RETIRED_BATCH_LEASE_SECONDS=900.0
# MEMORY_DB_RETIRED_BATCH_POLL_SECONDS=60.0
# MEMORY_DB_RELATIONSHIP_NEIGHBORS=2
# MEMORY_DB_RELATIONSHIP_READ_LIMIT=20

# Telegram Desktop streaming import.
# IMPORT_MAX_RECORD_BYTES=4194304
# IMPORT_BATCH_BYTES=1048576
# IMPORT_BATCH_MESSAGES=100

# Operator traversal and status output.
# MEMORY_OPERATIONS_PAGE_SIZE=100
# MEMORY_OPERATIONS_STATUS_JOB_LIMIT=100

# Additional shared embedding transport overrides.
# EMBEDDING_CONNECT_TIMEOUT_S=3.0
# EMBEDDING_RETRY_INITIAL_DELAY_S=0.5
# EMBEDDING_RETRY_MAX_DELAY_S=8.0
# EMBEDDING_RETRY_AFTER_MAX_S=30.0
# EMBEDDING_SYNC_BATCH_ITEMS=128
# EMBEDDING_BATCH_LIST_PAGE_SIZE=100
# EMBEDDING_BATCH_RECONCILE_MAX_PAGES=20
