# Required: your Telegram bot token.
TGBOT_TOKEN=

# Fill in at least ONE provider key. Leave unused providers empty.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# OpenRouter also needs a model ID from your account.
OPENROUTER_MODEL=

# Optional: choose the provider when several keys are configured.
DEFAULT_PROVIDER=

# Optional: comma-separated numeric chat IDs. Empty allows all chats.
TGBOT_WHITELIST=
# Optional: user IDs allowed to change advanced parameters.
TGBOT_CONTROL_UID_WHITELIST=

# Optional remote tools; see the deployment guide before enabling.
SSH_EXEC_ENABLED=false

# All remaining settings have defaults. See .env.full.example in the
# source repository for models, prompts, reply timing, stickers, and limits.
